# Dùng khi build tại máy để kéo-thả web/dist lên Netlify (Vite tự đọc file này lúc build).
# Copy thành web/.env (đã bị gitignore) rồi điền giá trị. Xem README mục 6.2.

# Gist công bố địa chỉ backend của site Vườn Hoa AI (vuon-hoa-ai.netlify.app) —
# mỗi phiên Colab tự cập nhật link tunnel vào đây:
VITE_API_DISCOVERY=https://api.github.com/gists/7b956575c05f6e7b223bfbbce6b08a09

# Hoặc ghim cứng một địa chỉ backend (khi không dùng gist công bố):
# VITE_API_URL=https://<link-tunnel>.trycloudflare.com
